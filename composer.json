{
    "name": "sammyjo20/lasso",
    "type": "library",
    "description": "Lasso - Asset wrangling for Laravel made simple.",
    "version": "1.2.7",
    "license": "MIT",
    "authors": [
        {
            "name": "Sam Carré",
            "email": "sam.carre2000@gmail.com"
        },
        {
            "name": "Jimmy Osborn",
            "email": "josborn@wright20.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-zip": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/finder": "^7.3|^8.0",
        "symfony/process": "^7.3|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "friendsofphp/php-cs-fixer": "^3.86"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sammyjo20\\Lasso\\LassoServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Sammyjo20\\Lasso\\": "src/",
            "Sammyjo20\\Lasso\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "minimum-stability": "stable"
}
